# ─────────────────────────────────────────────────────────────
# CineMatch — environment variables
# Copy to .env (`cp .env.example .env`) and fill in the keys.
# ─────────────────────────────────────────────────────────────

# ── API keys ─────────────────────────────────────────────────
# TMDB: movie/TV data, search, recommendations, providers, trailers.
# Free key: https://www.themoviedb.org/settings/api
# Leave empty to run on local mock data.
TMDB_API_KEY=

# OMDB (optional): adds IMDb / Rotten Tomatoes / Metacritic ratings.
# Free tier = 1,000 requests/day: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ── Data mode ────────────────────────────────────────────────
# true  = always use mock data, even if TMDB_API_KEY is set
# false = use TMDB when a key is present (mock data is used anyway if the key is empty)
USE_MOCK_DATA=false

# ── Server ───────────────────────────────────────────────────
# Port Node listens on when run directly (`npm start` / `npm run dev`).
# Ignored in Docker: the container always listens on 3000.
PORT=3000

# ── Docker ──────────────────────────────────────────────────
# Host port mapped to the container (docker-compose.yml → "${HOST_PORT}:3000").
HOST_PORT=8086
